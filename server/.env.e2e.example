# Live dev target; this suite signs in and signs out a dedicated hosted user.
E2E_API_URL=https://your-dev-api.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
# Relative to server/. Alternatively supply E2E_EMAIL and E2E_PASSWORD together.
E2E_ACCOUNT_FILE=../.env.codex-dev.json
