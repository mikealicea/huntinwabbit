# Select one live target; this suite signs in and signs out a dedicated hosted user.
# Dev (default):
E2E_API_URL=https://your-dev-api.example.com
# Prod: replace the active E2E_API_URL above only for an authorized production check.
# E2E_API_URL=https://your-prod-api.example.com
# Use the selected target's Supabase project and dedicated test account.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
# Relative to server/. Alternatively supply E2E_EMAIL and E2E_PASSWORD together.
E2E_ACCOUNT_FILE=../.env.codex-dev.json
# Production account-file alternative, provisioned separately:
# E2E_ACCOUNT_FILE=../.env.codex-prod.json
