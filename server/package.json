{
  "name": "serverless-typescript-boilerplate",
  "version": "0.1.0",
  "description": "Boilerplate HTTP API — Express 5 on AWS Lambda via Serverless Framework v4.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11 <12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "~24",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "rimraf": "~6.1.3",
    "serverless": "^4.39.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/local.ts",
    "dev": "node --env-file-if-exists=.env --watch src/local.ts",
    "clean": "rimraf coverage build tmp",
    "prebuild": "npm run check && npm run check-types",
    "check-types": "tsc --noEmit -p tsconfig.vitest.json",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "npm run clean && tsc -p tsconfig.release.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.all",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "update-all-deps": "npm outdated | awk 'NR>1 {print $1\"@\"$4}' | xargs npm install",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "express": "^5.2.1",
    "serverless-http": "^4.0.0",
    "tslib": "~2.8"
  },
  "packageManager": "npm@11.16.0"
}
