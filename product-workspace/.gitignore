# Keep workspace tool sources visible despite inherited Swift package ignores.
!toolbelt/packages/

# Dependencies
node_modules/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Environment & secrets
.env
.env.local
.env.*.local

# Lock files (optional - remove if you want to commit these)
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# OS files
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*

# Temporary files
tmp/
temp/
temp-resources/
*.tmp
*.temp
scratch/

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-alt.json

# Sensitive content
*.private.md
*-private.md
personal-notes/
clients/*/sensitive/

# Agent tooling internals
.agentkanban/
.pi/**/node_modules
.pi/**/dist
.omp/**/node_modules
.omp/**/dist
