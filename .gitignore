# Scratch dir: `npm run clean` targets it, and the local blob store writes
# uploaded clips here when SANCTUM_LOCAL_ADAPTERS=1.
server/tmp/

tmp-example/

# Scratch dir at the repo root. Ignored *before* anything is written to it, because
# what lands here is operational — resolved SSM values, dashboard paste sheets — and
# a secret is committable the moment the folder isn't.
/temp/

.obsidian

# Browser test artifacts
web/test-results/
web/playwright-report/

# Supabase checkout-local linkage and CLI state
supabase/.temp/
supabase/.branches/
