# Secrets and environment
# Dotenv files only (.env, .env.local, server/.env.production, …).
# Deliberately NOT `*.env.*`, which would also swallow source files like
# server/src/shared/shared.env.ts.
.env
.env.*
Secrets.swift
!Secrets.swift.example

# The client's backend configuration, injected into Info.plist at build time. One file per
# build configuration — Secrets.Debug.xcconfig points at dev, Secrets.Release.xcconfig at
# production. Matched by glob so a future configuration cannot be committed by accident; the
# committed `Secrets.example.xcconfig` documents the shape and is the one exception.
Secrets*.xcconfig
!Secrets.example.xcconfig
# Sentry CLI profiles contain the symbol-upload auth token. CI uses an environment secret instead.
.sentryclirc

