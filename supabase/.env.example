# Copy to ignored supabase/.env before running the root auth:push task.
# Match the production frontend's APP_ORIGIN; keep web/.env.local on localhost.
SUPABASE_AUTH_SITE_URL=https://your-app.example.com
# Use the same origin plus /auth/confirm for confirmation and recovery emails.
# env(...) substitutes a whole value; it does not append paths inside config.toml.
SUPABASE_AUTH_REDIRECT_URL=https://your-app.example.com/auth/confirm
