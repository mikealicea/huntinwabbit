{
  "name": "nextjs-agent-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "postbuild": "pagefind --site .next/server/app/blog --output-path public/_pagefind",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-blog": "^4.6.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "~24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.5.14",
    "jsdom": "^30.0.0",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0"
}
